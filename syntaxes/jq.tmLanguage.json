{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "jq",
  "scopeName": "source.jq",
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#func-def" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#variable" },
        { "include": "#format" },
        { "include": "#number" },
        { "include": "#operators" },
        { "include": "#parens" },
        { "include": "#array" },
        { "include": "#object" },
        { "include": "#builtin-function" },
        { "include": "#identifier" }
      ]
    },

    "comment": {
      "name": "comment.line.number-sign.jq",
      "begin": "#",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.jq" } },
      "end": "(?<=(?:^|[^\\\\\\n\\r])(?:\\\\\\\\)*)$"
    },

    "string": {
      "name": "string.quoted.double.jq",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.jq" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.jq" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#interpolation" },
        { "include": "#invalid-escape" }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.jq",
      "match": "\\\\(?:[\\\\\"/bfnrt]|u[0-9a-fA-F]{4})"
    },

    "invalid-escape": {
      "name": "invalid.illegal.escape.jq",
      "match": "\\\\."
    },

    "interpolation": {
      "name": "meta.embedded.jq",
      "begin": "\\\\\\(",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.jq" } },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.jq" } },
      "patterns": [{ "include": "#main" }]
    },

    "func-def": {
      "begin": "(?:^|(?<=[\\s;{(|)]))(def)\\s+([a-zA-Z_][a-zA-Z_0-9]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.def.jq" },
        "2": { "name": "entity.name.function.jq" }
      },
      "end": "(?=;)",
      "patterns": [{ "include": "#main" }]
    },

    "keywords": {
      "name": "keyword.control.jq",
      "match": "(?:^|(?<=[^a-zA-Z_0-9$@.]))(module|import|include|def|if|then|elif|else|end|as|reduce|foreach|try|catch|label|break)(?=$|[^a-zA-Z_0-9])"
    },

    "constants": {
      "name": "constant.language.jq",
      "match": "(?:^|(?<=[^a-zA-Z_0-9$@.]))(true|false|null)(?=$|[^a-zA-Z_0-9])"
    },

    "variable": {
      "patterns": [
        {
          "name": "variable.language.loc.jq",
          "match": "\\$__loc__"
        },
        {
          "name": "variable.other.jq",
          "match": "\\$[a-zA-Z_][a-zA-Z_0-9]*"
        }
      ]
    },

    "format": {
      "name": "support.function.format.jq",
      "match": "@[a-zA-Z_0-9]+"
    },

    "number": {
      "name": "constant.numeric.jq",
      "match": "(?:^|(?<=[^a-zA-Z_0-9$@.]))(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?=$|[^a-zA-Z_0-9])"
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.jq",
          "match": "\\|=|//=|\\+=|-=|\\*=|/=|%=|(?<![<>=!])=(?!=)"
        },
        {
          "name": "keyword.operator.jq",
          "match": "\\?//|//|==|!=|<=|>=|\\.\\.|\\?|\\||\\+|-|\\*|/|%|<|>|\\$"
        },
        {
          "name": "keyword.operator.logical.jq",
          "match": "(?:^|(?<=[^a-zA-Z_0-9$@.]))(and|or)(?=$|[^a-zA-Z_0-9])"
        },
        {
          "name": "punctuation.separator.jq",
          "match": ",|;"
        },
        {
          "name": "punctuation.separator.colon.jq",
          "match": ":"
        },
        {
          "name": "keyword.operator.accessor.jq",
          "match": "\\."
        }
      ]
    },

    "parens": {
      "begin": "\\(",
      "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.jq" } },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.parens.end.jq" } },
      "patterns": [{ "include": "#main" }]
    },

    "array": {
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.jq" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.section.brackets.end.jq" } },
      "patterns": [{ "include": "#main" }]
    },

    "object": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.jq" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.jq" } },
      "patterns": [{ "include": "#main" }]
    },

    "builtin-function": {
      "name": "support.function.builtin.jq",
      "match": "(?:^|(?<=[^a-zA-Z_0-9$@.]))(not|empty|error|map|map_values|select|recurse|env|input|inputs|debug|stderr|paths|length|utf8bytelength|keys|keys_unsorted|values|has|in|contains|inside|path|getpath|setpath|delpaths|del|to_entries|from_entries|with_entries|add|any|all|flatten|range|floor|sqrt|pow|log|exp|log10|log2|exp10|exp2|expm1|fabs|round|ceil|rint|significand|logb|scalb|scalbln|nearbyint|trunc|isnan|isinfinite|isnormal|isfinite|infinite|nan|abs|toarray|toboolean|type|tostring|tonumber|tojson|fromjson|ascii_downcase|ascii_upcase|explode|implode|split|join|ltrimstr|rtrimstr|trimstr|ltrim|rtrim|trim|startswith|endswith|test|match|capture|scan|splits|sub|gsub|tostream|fromstream|truncate_stream|group_by|unique|unique_by|min|max|min_by|max_by|sort|sort_by|reverse|indices|index|rindex|bsearch|limit|first|last|nth|until|while|repeat|halt|halt_error|todate|todateiso8601|fromdate|fromdateiso8601|now|strptime|strftime|strflocaltime|mktime|gmtime|localtime|dateadd|datesub|date|arrays|objects|booleans|numbers|strings|nulls|iterables|scalars|finites|normals|isempty|input_line_number|input_filename|builtins|combinations|transpose|walk|pick|skip|format|IN|INDEX|JOIN|acos|acosh|asin|asinh|atan|atan2|atanh|cbrt|copysign|cos|cosh|drem|erf|erfc|fdim|fma|fmax|fmin|fmod|frexp|gamma|hypot|j0|j1|jn|ldexp|lgamma|lgamma_r|modf|nextafter|nexttoward|remainder|sin|sinh|tan|tanh|tgamma|y0|y1|yn|modulemeta|get_jq_origin|get_prog_origin|get_search_list|have_decnum|have_literal_numbers)(?=$|[^a-zA-Z_0-9])"
    },

    "identifier": {
      "name": "meta.identifier.jq",
      "match": "[a-zA-Z_][a-zA-Z_0-9]*"
    }
  }
}
