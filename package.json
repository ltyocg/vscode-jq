{
  "name": "vscode-jq",
  "displayName": "jq Language Support",
  "version": "0.1.0",
  "description": "Syntax highlighting, formatting and language-server features for the jq language (jqlang)",
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "formatter",
    "highlighting",
    "jq",
    "jqlang",
    "language server",
    "lsp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gigaplant/vscode-jq"
  },
  "publisher": "gigaplant",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./ && node esbuild.mts --production",
    "watch": "node esbuild.mts --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "tsc -p ./ && node --test \"out/**/*.test.js\"",
    "package": "node -e \"fs.mkdirSync('build', {recursive: true})\" && vsce package --no-dependencies --out build/"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.78.0",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "jq",
        "aliases": [
          "jq",
          "jqlang"
        ],
        "extensions": [
          ".jq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jq",
        "scopeName": "source.jq",
        "path": "./syntaxes/jq.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "jq.enter",
        "title": "Smart Enter (formatter-aligned indent)",
        "category": "jq"
      }
    ],
    "keybindings": [
      {
        "key": "enter",
        "command": "jq.enter",
        "when": "editorTextFocus && resourceLangId == jq && !suggestWidgetVisible && !inSnippetMode && !renameInputVisible && !editorReadonly"
      },
      {
        "key": "numpad_enter",
        "command": "jq.enter",
        "when": "editorTextFocus && resourceLangId == jq && !suggestWidgetVisible && !inSnippetMode && !renameInputVisible && !editorReadonly"
      }
    ],
    "configurationDefaults": {
      "[jq]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoClosingDelete": "always"
      }
    },
    "configuration": {
      "title": "jq",
      "properties": {
        "jq.format.printWidth": {
          "type": "integer",
          "default": 100,
          "minimum": 20,
          "description": "Maximum line width before the formatter breaks pipelines and lists."
        },
        "jq.format.indentSize": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of spaces per indentation level. Also kept in sync with the editor's tab size for jq files."
        },
        "jq.format.trailingComma": {
          "type": "string",
          "enum": [
            "never",
            "multiline",
            "preserve"
          ],
          "default": "never",
          "enumDescriptions": [
            "Never emit a trailing comma; remove any trailing comma found in object constructors.",
            "Add a trailing comma after the last entry of expanded (multiline) object constructors; remove it in single-line ones.",
            "Keep trailing commas exactly as written in the source."
          ],
          "description": "Trailing comma policy for object constructors (the only place where a trailing comma is legal in jq)."
        },
        "jq.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the jq-lsp language server for diagnostics, completion, hover and go-to-definition. Formatting is unaffected by this setting."
        },
        "jq.lsp.path": {
          "type": "string",
          "default": "jq-lsp",
          "description": "Command or absolute path of the jq-lsp binary (github.com/wader/jq-lsp)."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.146.0"
  }
}
