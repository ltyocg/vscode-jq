{
  "name": "vscode-jq",
  "displayName": "jq Language Support",
  "description": "Syntax highlighting, formatting and language-server features for the jq language (jqlang)",
  "version": "0.1.0",
  "publisher": "gigaplant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gigaplant/vscode-jq"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "packageManager": "pnpm@12.11.2",
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "jq",
    "jqlang",
    "highlighting",
    "formatter",
    "lsp",
    "language server"
  ],
  "activationEvents": [
    "onLanguage:jq"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jq",
        "aliases": [
          "jq",
          "jqlang"
        ],
        "extensions": [
          ".jq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jq",
        "scopeName": "source.jq",
        "path": "./syntaxes/jq.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "jq",
      "properties": {
        "jq.format.printWidth": {
          "type": "integer",
          "default": 80,
          "minimum": 20,
          "description": "Maximum line width before the formatter breaks pipelines and lists."
        },
        "jq.format.indentSize": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of spaces per indentation level."
        },
        "jq.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the jq-lsp language server for diagnostics, completion, hover and go-to-definition. Formatting is unaffected by this setting."
        },
        "jq.lsp.path": {
          "type": "string",
          "default": "jq-lsp",
          "description": "Command or absolute path of the jq-lsp binary (github.com/wader/jq-lsp)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./ && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package --no-dependencies --out build/"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
